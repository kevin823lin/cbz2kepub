# Personal settings; keep the public example.
/config.toml

# Local Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local inputs, outputs and temporary workspaces.
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep
/tmp/
/.agent/scratch/
/KCC-*/
/LLL-*/
.cbz2kepub-work/
