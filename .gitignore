/.cbz2kepub-work/*
!/.cbz2kepub-work/.gitkeep
.cbz2kepub-publish-*/
.cbz2kepub-*.json
.cbz2kepub.lock
*.cbz
*.cbr
*.epub
*.log
*.tmp

# Build artifacts and machine-specific files.
/build/
/dist/
*.egg-info/
.DS_Store
Thumbs.db
Desktop.ini
